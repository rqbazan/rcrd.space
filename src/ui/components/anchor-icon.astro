---
import { cn } from "~/utils/cn.ts";
import { getExternalLinkProps } from "~/utils/get-external-link-props.ts";

interface Props {
  href: string;
  class?: string;
}

const { class: className, href, ...otherProps } = Astro.props;
---

{/* biome-ignore lint/a11y/useAnchorContent: the content comes through the slot */}
<a
  href={href}
  class={cn("text-muted hover:text-wording transition-colors ease-in-out duration-300", className)}
  {...getExternalLinkProps(href)}
  {...otherProps}
>
  <slot />
</a>
